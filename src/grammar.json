{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "namumark",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "wiki_block"
        },
        {
          "type": "SYMBOL",
          "name": "nowiki_inline"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "wiki_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "wiki_block_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "wiki_block_header"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "wiki_block_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "wiki_block_end"
        }
      ]
    },
    "wiki_block_header": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "attribute"
          },
          {
            "type": "SYMBOL",
            "name": "_header_text"
          }
        ]
      }
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "PATTERN",
            "value": "[a-zA-Z_][a-zA-Z0-9_-]*"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\\"[^\\\"]*\\\""
              },
              {
                "type": "PATTERN",
                "value": "\\'[^\\']*\\'"
              },
              {
                "type": "PATTERN",
                "value": "[^\\s\"'>]+"
              }
            ]
          }
        }
      ]
    },
    "_header_text": {
      "type": "PATTERN",
      "value": "[^\\n=\"'\\s]+"
    },
    "wiki_block_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "nowiki_inline": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "nowiki_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "content",
              "content": {
                "type": "SYMBOL",
                "name": "nowiki_content"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "nowiki_end"
        }
      ]
    },
    "nowiki_content": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^}]+"
          },
          {
            "type": "STRING",
            "value": "}"
          }
        ]
      }
    },
    "text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^{}\\r\\n]+"
        },
        {
          "type": "PATTERN",
          "value": "\\r?\\n"
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": -10,
            "content": {
              "type": "STRING",
              "value": "}"
            }
          }
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "wiki_block_start"
    },
    {
      "type": "SYMBOL",
      "name": "nowiki_start"
    },
    {
      "type": "SYMBOL",
      "name": "wiki_block_end"
    },
    {
      "type": "SYMBOL",
      "name": "nowiki_end"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}